code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float u;
uniform float v;
uniform sampler2D heightmap;
uniform int height;



void vertex() {
// Input:4
	vec2 n_out4p0 = UV;


// VectorDecompose:3
	float n_out3p0 = vec3(n_out4p0, 0.0).x;
	float n_out3p1 = vec3(n_out4p0, 0.0).y;
	float n_out3p2 = vec3(n_out4p0, 0.0).z;


// FloatParameter:2
	float n_out2p0 = u;


// FloatOp:6
	float n_out6p0 = n_out3p0 + n_out2p0;


// FloatParameter:5
	float n_out5p0 = v;


// FloatOp:7
	float n_out7p0 = n_out3p1 + n_out5p0;


// VectorCompose:8
	float n_in8p2 = 0.00000;
	vec3 n_out8p0 = vec3(n_out6p0, n_out7p0, n_in8p2);


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(heightmap, vec2(n_out8p0.xy));


// IntParameter:9
	int n_out9p0 = height;


// VectorCompose:12
	float n_in12p0 = 0.00000;
	float n_in12p2 = 0.00000;
	vec3 n_out12p0 = vec3(n_in12p0, float(n_out9p0), n_in12p2);


// VectorOp:13
	vec3 n_out13p0 = vec3(n_out11p0.xyz) * n_out12p0;


// Input:14
	vec3 n_out14p0 = VERTEX;


// VectorOp:15
	vec3 n_out15p0 = n_out13p0 + n_out14p0;


// Output:0
	VERTEX = n_out15p0;


}
